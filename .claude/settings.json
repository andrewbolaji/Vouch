{
  "$schema": "https://json.schemastore.org/claude-code-settings.json",
  "permissions": {
    "allow": [
      "Bash(flutter pub get:*)",
      "Bash(flutter test)",
      "Bash(flutter test test/:*)",
      "Bash(flutter analyze:*)",
      "Bash(flutter doctor:*)",
      "Bash(flutter run:*)",
      "Bash(flutterfire configure:*)",
      "Bash(dart format:*)",
      "Bash(dart run build_runner:*)",
      "Bash(brew --prefix:*)",
      "Bash(npm run lint)",
      "Bash(npm run build)",
      "Bash(npm run test:emulator)",
      "Bash(npm ci)",
      "Bash(npx jest:*)",
      "Bash(npx tsc:*)",
      "Bash(npx eslint:*)",
      "Bash(firebase emulators:exec --only firestore,auth --project vouch-test 'cd functions && npx jest --forceExit')",
      "Bash(git status:*)",
      "Bash(git diff:*)",
      "Bash(git log:*)",
      "Bash(git show:*)",
      "Bash(git add:*)",
      "Bash(git commit:*)",
      "Bash(git push)",
      "Bash(git branch:*)",
      "Bash(git switch:*)",
      "Bash(git stash push:*)",
      "Bash(git stash list:*)"
    ],
    "ask": [
      "Edit(./.claude/**)",
      "Write(./.claude/**)",
      "Edit(./CLAUDE.md)",
      "Write(./CLAUDE.md)",
      "Edit(./**/package.json)",
      "Write(./**/package.json)",
      "Bash(npm install:*)",
      "Bash(npm i:*)"
    ],
    "deny": [
      "Read(./.env)",
      "Read(./.env.*)",
      "Read(./**/serviceAccountKey*.json)",
      "Read(./**/*-adminsdk-*.json)",
      "Read(./**/*credentials*.json)",
      "Read(./**/*.p8)",
      "Read(./**/*.pem)",
      "Read(./**/*.key)",
      "Bash(flutter test --update-goldens:*)",
      "Bash(flutter test *--update-goldens*)",
      "Bash(git push --force:*)",
      "Bash(git push -f:*)",
      "Bash(rm -rf:*)",
      "Bash(rm -fr:*)",
      "Bash(rm -r:*)",
      "Bash(rm -R:*)",
      "Bash(rm --recursive:*)",
      "Bash(firebase deploy:*)",
      "Bash(firebase functions:delete:*)",
      "Bash(firebase firestore:delete:*)",
      "Bash(npm run deploy:*)",
      "Bash(flutter build ipa:*)",
      "Bash(flutter build appbundle:*)",
      "Bash(xcrun altool:*)",
      "Bash(fastlane:*)"
    ]
  },
  "hooks": {
    "Stop": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "bash \"${CLAUDE_PROJECT_DIR:-.}/.claude/hooks/run-tests.sh\"",
            "timeout": 900
          }
        ]
      }
    ]
  }
}
