rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {

    // -------------------------------------------------------
    // Helper functions
    // -------------------------------------------------------

    function isAuthenticated() {
      return request.auth != null;
    }

    function isOwner(uid) {
      return isAuthenticated() && request.auth.uid == uid;
    }

    function isEmailVerified() {
      return request.auth.token.email_verified == true;
    }

    function membershipTier() {
      return request.auth.token.membershipTier;
    }

    function isPaidTier() {
      return membershipTier() in ['localsPass', 'cityInsider'];
    }

    function isCityInsider() {
      return membershipTier() == 'cityInsider';
    }

    // -------------------------------------------------------
    // cities - public read, no client writes
    // -------------------------------------------------------
    match /cities/{cityId} {
      allow read: if true;
      allow write: if false;
    }

    // -------------------------------------------------------
    // restaurants - public discovery + paid tier gating
    //
    // Ranks 1-5 are publicly readable (no auth required).
    // Ranks 6-10 require authentication AND a paid tier
    // (localsPass or cityInsider).
    // -------------------------------------------------------
    match /restaurants/{restaurantId} {
      allow read: if resource.data.rank <= 5
        || (isAuthenticated() && isPaidTier());
      allow write: if false;

      // ---------------------------------------------------
      // insiderNotes subcollection - cityInsider only
      // ---------------------------------------------------
      match /insiderNotes/{noteId} {
        allow read: if isAuthenticated() && isCityInsider();
        allow write: if false;
      }

      // ---------------------------------------------------
      // votes subcollection - doc ID = user UID
      //
      // Users can create and delete their own vote doc only.
      // No updates allowed.
      //
      // get is scoped to the caller's own doc, so a client can
      // check its own hasVoted via a single doc get. list is
      // denied outright: nothing in the app enumerates other
      // users' votes for a restaurant, and a prior version of
      // this rule allowed any authenticated user to get any
      // other user's vote doc, justified by a hasVoted check
      // the app never actually performed that way (AppState's
      // real hasVoted read local state only). Fixed 2026-08-13.
      // ---------------------------------------------------
      match /votes/{userId} {
        allow get: if isOwner(userId);
        allow list: if false;
        allow create: if isOwner(userId)
          && isEmailVerified()
          && request.resource.data.weight == 1
          && request.resource.data.createdAt == request.time;
        allow update: if false;
        allow delete: if isOwner(userId);
      }

      // ---------------------------------------------------
      // comments subcollection
      //
      // Create with validation, delete own only, no updates.
      // ---------------------------------------------------
      match /comments/{commentId} {
        allow read: if isAuthenticated();

        // The submitComment callable is the only way to create a
        // comment. It runs the content filter server-side before
        // writing and writes via the Admin SDK, which bypasses this
        // rule entirely, so a direct client create has no path left.
        allow create: if false;

        // Only the comment author can delete their own comment
        allow delete: if isAuthenticated()
          && resource.data.userId == request.auth.uid;

        allow update: if false;
      }
    }

    // -------------------------------------------------------
    // users - read/write own doc only
    // -------------------------------------------------------
    match /users/{uid} {
      allow read: if isOwner(uid);
      allow create: if isOwner(uid);
      // Cannot change the id field on update.
      //
      // votedRestaurantIds is trigger-owned: the onVoteCreated /
      // onVoteDeleted triggers maintain it via the Admin SDK, which
      // bypasses these rules. A client changing it here could only
      // lie to its own UI (rank reads the votes subcollection, never
      // this field), but leaving it client-writable would mean the
      // one field the client is supposed to treat as server truth is
      // the one field it can forge. The .get(..., []) form is
      // required so this clause still evaluates on documents written
      // before the field existed, where a bare field access errors.
      allow update: if isOwner(uid)
        && request.resource.data.id == resource.data.id
        && request.resource.data.get('votedRestaurantIds', [])
           == resource.data.get('votedRestaurantIds', []);

      // ---------------------------------------------------
      // suggestionCounts subcollection
      //
      // Cloud Function writes these for rate limiting.
      // Clients can read their own counts for display.
      // ---------------------------------------------------
      match /suggestionCounts/{dateKey} {
        allow read: if isOwner(uid);
        allow write: if false;
      }

      // ---------------------------------------------------
      // reportCounts subcollection
      //
      // Client increments after each report submission.
      // Rate-limited to kDailyReportCap (5) per day.
      //
      // count must start at 1 and increase by exactly 1 per write,
      // so a client cannot reset or bank its own daily counter.
      // ---------------------------------------------------
      match /reportCounts/{dateKey} {
        allow read: if isOwner(uid);
        allow create: if isOwner(uid)
          && request.resource.data.date == dateKey
          && request.resource.data.count == 1;
        allow update: if isOwner(uid)
          && request.resource.data.date == dateKey
          && request.resource.data.count == resource.data.count + 1;
        allow delete: if false;
      }
    }

    // -------------------------------------------------------
    // reports - user can create own, read only own, never list all
    //
    // Reports queue for manual admin review in the Firebase console.
    // No client can read the full collection or other users' reports.
    // -------------------------------------------------------
    match /reports/{reportId} {
      allow read: if isAuthenticated()
        && resource.data.reporterUid == request.auth.uid;

      allow create: if isAuthenticated()
        && request.resource.data.reporterUid == request.auth.uid
        && request.resource.data.commentId is string
        && request.resource.data.commentPath is string
        && request.resource.data.restaurantId is string
        && request.resource.data.reason is string
        && request.resource.data.reason in ['spam', 'harassment', 'inappropriate', 'other']
        && request.resource.data.createdAt == request.time;

      allow update: if false;
      allow delete: if false;
    }

    // -------------------------------------------------------
    // waitlist - admin-only (Cloud Function via Admin SDK)
    //
    // No client can read or write. The waitlistSignup HTTPS
    // function uses the Admin SDK which bypasses rules.
    // -------------------------------------------------------
    match /waitlist/{docId} {
      allow read: if false;
      allow write: if false;
    }

    // -------------------------------------------------------
    // voteEvents - admin-only (Cloud Function via Admin SDK)
    //
    // Append-only vote audit trail. No client can read or write,
    // not even the user the event is about. Written by the
    // onVoteCreated/onVoteDeleted triggers using the Admin SDK,
    // which bypasses rules. Read only via console or script.
    // -------------------------------------------------------
    match /voteEvents/{eventId} {
      allow read: if false;
      allow write: if false;
    }

    // -------------------------------------------------------
    // suggestions - no direct client creates
    //
    // Only the Cloud Function (admin SDK) can create
    // suggestions. Authenticated users can read their own.
    // -------------------------------------------------------
    match /suggestions/{suggestionId} {
      allow read: if isAuthenticated()
        && resource.data.userId == request.auth.uid;
      allow create: if false;
      allow update: if false;
      allow delete: if false;
    }
  }
}
